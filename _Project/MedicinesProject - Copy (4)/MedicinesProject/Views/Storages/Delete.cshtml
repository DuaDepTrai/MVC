@model MedicinesProject.Storages

@{
    ViewBag.Title = "Delete";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container delete-container">
    <div class="card border-danger">
        <div class="card-body">
            <h3 class="text-danger mb-4">Confirm delete this receipt?</h3>
            <hr />

            <dl class="row">
                <dt>
                    Receipt Code
                </dt>

                <dd>
                    @Html.DisplayFor(model => model.ReceiptCode)
                </dd>

                <dt>
                    Batch Number
                </dt>

                <dd>
                    @Html.DisplayFor(model => model.BatchNumber)
                </dd>

                <dt>
                    Trade Name
                </dt>

                <dd>
                    @Html.DisplayFor(model => model.Medicines.TradeName)
                </dd>

                <dt>
                    Manufacture Date
                </dt>

                <dd>
                    @Html.DisplayFor(model => model.ManufactureDate)
                </dd>

                <dt>
                    Expiry Date
                </dt>

                <dd>
                    @Html.DisplayFor(model => model.ExpiryDate)
                </dd>

                <dt>
                    Quantity
                </dt>

                <dd>
                    @Html.DisplayFor(model => model.Quantity)
                </dd>

                <dt>
                    Import Price
                </dt>

                <dd>
                    @Html.DisplayFor(model => model.ImportPrice)
                </dd>

                <dt>
                    Import Date
                </dt>

                <dd>
                    @Html.DisplayFor(model => model.ImportDate)
                </dd>

                <dt>
                    Supplier
                </dt>

                <dd>
                    @Html.DisplayFor(model => model.Suppliers.SupplierName)
                </dd>

            </dl>

            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()

                <div class="card-footer text-end">
                    <input type="submit" value="Delete" class="btn btn-danger btn-space" />
                    @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-secondary" })
                </div>
            }
        </div>
    </div>
</div>

<!-- Bootstrap 5 JS (Optional) -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
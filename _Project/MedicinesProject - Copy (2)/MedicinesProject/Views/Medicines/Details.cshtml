@model MedicinesProject.Medicines

@{
    ViewBag.Title = "Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container details-container">
    <div class="card">
        <div class="card-body">
            <h2 class="mb-4 text-primary">Medicine Information</h2>
            <hr />

            <dl class="row">
                <dt>
                    Trade Name
                </dt>

                <dd>
                    @Html.DisplayFor(model => model.TradeName)
                </dd>

                <dt>
                    Active Ingredient
                </dt>

                <dd>
                    @Html.DisplayFor(model => model.ActiveIngredient)
                </dd>

                <dt>
                    Category
                </dt>

                <dd>
                    @Html.DisplayFor(model => model.MedicineCategories.CategoryName)
                </dd>

                <dt>
                    Unit
                </dt>

                <dd>
                    @Html.DisplayFor(model => model.Unit)
                </dd>

                <dt>
                    Concentration
                </dt>

                <dd>
                    @Html.DisplayFor(model => model.Concentration)
                </dd>

                <dt>
                    Form
                </dt>

                <dd>
                    @Html.DisplayFor(model => model.Form)
                </dd>

                <dt>
                    Sale Price
                </dt>

                <dd>
                    @Html.DisplayFor(model => model.SalePrice)
                </dd>

                <dt>
                    Manufacturer
                </dt>

                <dd>
                    @Html.DisplayFor(model => model.Manufacturers.Name)
                </dd>

            </dl>

            <div class="card-footer text-end">
                @Html.ActionLink("Edit", "Edit", new { id = Model.MedicineID }, new { @class = "btn btn-primary btn-space" })
                @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-secondary" })
            </div>
        </div>
    </div>
</div>

<!-- Bootstrap JS (Optional) -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

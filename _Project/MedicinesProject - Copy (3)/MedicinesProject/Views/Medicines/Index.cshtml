@model IEnumerable<MedicinesProject.Medicines>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Medicines";
}

<div class="sticky-header mb-3 p-3 bg-light border rounded">
    <div class="d-flex justify-content-between align-items-center flex-wrap">
        <p class="mb-2">
            @Html.ActionLink("Add New Medicine", "Create", null, new { @class = "btn btn-primary" })
        </p>

        @using (Html.BeginForm("Index", "Medicines", FormMethod.Get, new { @class = "form-inline d-flex flex-wrap justify-content-end" }))
        {
            <input type="text" name="searchStr" id="searchStr" class="form-control mr-2 mb-2" style="min-width: 380px;" placeholder="Search by Name/Active Ingredient/Manufacturer" value="@ViewBag.CurrentSearch" />

            @Html.DropDownList("activeIngredientFilter",
                new SelectList(ViewBag.ActiveIngredients as List<string>, ViewBag.ActiveIngredientFilter as string),
                "Filter by Active Ingredients",
                new { @class = "form-control mr-2 mb-2" })
            @Html.DropDownList("categoryFilter",
                new SelectList(ViewBag.Categories as List<string>, ViewBag.CategoryFilter as string),
                "Filter by Categories",
                new { @class = "form-control mr-2 mb-2" })
            @Html.DropDownList("manufacturerFilter",
                new SelectList(ViewBag.Manufacturers as List<string>, ViewBag.ManufacturerFilter as string),
                "Filter by Active Manufacturers",
                new { @class = "form-control mr-2 mb-2" })

            <button type="submit" class="btn btn-primary mb-2">
                <i class="fas fa-search"></i>
            </button>

            <a href="@Url.Action("Index", "Medicines")" class="btn btn-primary mb-2 ml-2">
                <i class="fas fa-sync-alt"></i>
            </a>
        }
    </div>
</div>



<table class="table table-striped">
    <thead>
        <tr>
            <th style="width: 12%;">
                Trade Name
            </th>
            <th style="width: 12%;">
                Active Ingredient
            </th>
            <th style="width: 17%;">
                Category
            </th>
            <th style="width: 6%;">
                Unit
            </th>
            <th style="width: 7%;">
                Concentration
            </th>
            <th style="width: 6%;">
                Form
            </th>
            <th style="width: 6%;">
                Sale Price
            </th>
            <th style="width: 26%;">
                Manufacturer
            </th>
            <th style="width: 8%;">

            </th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.TradeName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.ActiveIngredient)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.MedicineCategories.CategoryName)
                </td>
                <td style=" text-align: center;">
                    @Html.DisplayFor(modelItem => item.Unit)
                </td>
                <td style=" text-align: center;">
                    @Html.DisplayFor(modelItem => item.Concentration)
                </td>
                <td style=" text-align: center;">
                    @Html.DisplayFor(modelItem => item.Form)
                </td>
                <td style=" text-align: right;">
                    @Html.DisplayFor(modelItem => item.SalePrice)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Manufacturers.Name)
                </td>
                <td class="action-column" style=" text-align: center;">
                    <a href="@Url.Action("Details", new { id = item.MedicineID })" class="btn btn-info btn-sm">
                        <i class="fas fa-info-circle"></i>
                    </a>
                    <a href="@Url.Action("Edit", new { id = item.MedicineID })" class="btn btn-warning btn-sm">
                        <i class="fas fa-edit"></i>
                    </a>
                    <a href="@Url.Action("Delete", new { id = item.MedicineID })" class="btn btn-danger btn-sm">
                        <i class="fas fa-trash-alt"></i>
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (ViewBag.TotalPages > 1)
{
    int maxPagesToShow = 10;
    int currentPage = ViewBag.CurrentPage;
    int totalPages = ViewBag.TotalPages;

    int startPage = Math.Max(1, currentPage - (maxPagesToShow / 2));
    int endPage = Math.Min(totalPages, startPage + maxPagesToShow - 1);

    if (endPage - startPage < maxPagesToShow - 1)
    {
        startPage = Math.Max(1, endPage - maxPagesToShow + 1);
    }

    <div class="pagination-container text-center" id="pagination-inventory">
        <div class="pagination d-inline-block">
            <ul class="pagination" style="display: flex; list-style: none; padding: 0; margin: 0; font-size: 12px;">
                <li style="margin: 0 5px;">
                    <a href="@(currentPage == 1 ? "#" : Url.Action("Index", new { page = currentPage - 1 }))"
                       style="padding: 8px 15px; border: 1px solid #ddd; border-radius: 4px; color: #007bff; text-decoration: none; transition: background-color 0.3s, color 0.3s; font-weight: bold; @(currentPage == 1 ? "opacity: 0.5; cursor: not-allowed;" : "")"
                       @(currentPage == 1 ? "onclick=\"return false;\"" : "")>
                        « Prev
                    </a>
                </li>

                @for (int i = startPage; i <= endPage; i++)
                {
                    <li style="margin: 0 5px;" class="@(i == currentPage ? "active" : "")">
                        <a href="@Url.Action("Index", new { page = i })"
                           style="padding: 8px 15px; border: 1px solid #ddd; border-radius: 4px; color: @(i == currentPage ? "white" : "#007bff"); text-decoration: none; transition: background-color 0.3s, color 0.3s; @(i == currentPage ? "background-color: #007bff;" : "")">
                            @i
                        </a>
                    </li>
                }

                <li style="margin: 0 5px;">
                    <a href="@(currentPage == totalPages ? "#" : Url.Action("Index", new { page = currentPage + 1 }))"
                       style="padding: 8px 15px; border: 1px solid #ddd; border-radius: 4px; color: #007bff; text-decoration: none; transition: background-color 0.3s, color 0.3s; font-weight: bold; @(currentPage == totalPages ? "opacity: 0.5; cursor: not-allowed;" : "")"
                       @(currentPage == totalPages ? "onclick=\"return false;\"" : "")>
                        Next »
                    </a>
                </li>
            </ul>
            <p style="padding-top: 10px">Page @currentPage of @totalPages</p>
        </div>
    </div>
}
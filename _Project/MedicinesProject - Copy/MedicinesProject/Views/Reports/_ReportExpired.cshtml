@model List<MedicinesProject.Models.ViewModels.StorageReportItem>

<h4>Expired Report</h4>
<table class="table table-bordered table-danger">
    <thead>
        <tr>
            <th>Receipt Code</th>
            <th>Trade Name</th>
            <th>Active Ingredient</th>
            <th>Batch Number</th>
            <th>Quantity</th>
            <th>Manufacture Date</th>
            <th>Expiry Date</th>
            <th>Import Date</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.ReceiptCode</td>
                <td>@item.TradeName</td>
                <td>@item.ActiveIngredient</td>
                <td>@item.BatchNumber</td>
                <td>@item.Quantity</td>
                <td>@item.ManufactureDate.ToString("dd-MM-yyyy")</td>
                <td>@item.ExpiryDate.ToString("dd-MM-yyyy")</td>
                <td>@item.ImportDate.ToString("dd-MM-yyyy")</td>
            </tr>
        }
    </tbody>
</table>

@{
    int maxPagesToShow = 10;
    int currentPage = ViewBag.CurrentPageExpired;
    int totalPages = ViewBag.TotalPagesExpired;

    int startPage = Math.Max(1, currentPage - (maxPagesToShow / 2));
    int endPage = Math.Min(totalPages, startPage + maxPagesToShow - 1);

    if (endPage - startPage < maxPagesToShow - 1)
    {
        startPage = Math.Max(1, endPage - maxPagesToShow + 1);
    }
}

<div class="col-lg-12 text-center pagination-container">
    <div class="pagination d-inline-block">
        <ul class="pagination">
            @*@if (currentPage > 1)
        {
            <li><a href="@Url.Action("Index", new { page = 1 })">« First</a></li>
            <li><a href="@Url.Action("Index", new { page = currentPage - 1 })">‹ Prev</a></li>
        }*@

            @for (int i = startPage; i <= endPage; i++)
            {
                <li class="@(i == currentPage ? "active" : "")">
                    <a href="@Url.Action("Index", new { expiredPage = i })">@i</a>
                </li>
            }

            @*@if (currentPage < totalPages)
        {
            <li><a href="@Url.Action("Index", new { page = currentPage + 1 })">Next ›</a></li>
            <li><a href="@Url.Action("Index", new { page = totalPages })">Last »</a></li>
        }*@
        </ul>
        <p style="padding-top: 10px">Page @currentPage of @totalPages</p>
    </div>
</div>

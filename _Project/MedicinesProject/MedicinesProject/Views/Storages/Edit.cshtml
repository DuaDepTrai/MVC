@model MedicinesProject.Storages

@{
    ViewBag.Title = "Edit";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container edit-container">
    <div class="card">
        <div class="card-body">
            <h2 class="text-primary">Edit Receipt</h2>
            <hr />

            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()

                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                @Html.HiddenFor(model => model.StorageID)

                <div class="row mb-3">
                    <div class="col-md-4">
                        <span class="fw-bold">Receipt Code</span>
                        @Html.EditorFor(model => model.ReceiptCode, new { htmlAttributes = new { @class = "form-control", @readonly = "readonly" } })
                        @Html.ValidationMessageFor(model => model.ReceiptCode, "", new { @class = "text-danger" })
                    </div>


                    <div class="col-md-4">
                        <span class="fw-bold">Batch Number</span>
                        @Html.EditorFor(model => model.BatchNumber, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(model => model.BatchNumber, "", new { @class = "text-danger" })
                    </div>

                    <div class="col-md-4">
                        <span class="fw-bold">Trade </span>
                        @Html.DropDownList("MedicineID", null, htmlAttributes: new { @class = "form-control" })
                        @Html.ValidationMessageFor(model => model.MedicineID, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <span class="fw-bold">Manufacture Date</span>
                        @Html.TextBoxFor(model => model.ManufactureDate,new{@class = "form-control flatpickr", 
                            @autocomplete = "off", @Value = Model.ManufactureDate.ToString("dd-MM-yyyy")})
                        @Html.ValidationMessageFor(model => model.ManufactureDate, "", new { @class = "text-danger" })
                    </div>

                    <div class="col-md-6">
                        <span class="fw-bold">Expiry Date</span>
                        @Html.TextBoxFor(model => model.ExpiryDate, new{@class = "form-control flatpickr",
                            @autocomplete = "off", @Value = Model.ExpiryDate.ToString("dd-MM-yyyy")})
                        @Html.ValidationMessageFor(model => model.ExpiryDate, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <span class="fw-bold">Quantity</span>
                        @Html.EditorFor(model => model.Quantity, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(model => model.Quantity, "", new { @class = "text-danger" })
                    </div>

                    <div class="col-md-6">
                        <span class="fw-bold">Import Price</span>
                        @Html.EditorFor(model => model.ImportPrice, new{htmlAttributes = new{@class = "form-control",
                            @type = "number",@step = "1",@value = Model.ImportPrice.ToString("0")}})                        
                        @Html.ValidationMessageFor(model => model.ImportPrice, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <span class="fw-bold">Import Date</span>
                        @Html.TextBoxFor(model => model.ImportDate, new{@class = "form-control flatpickr",
                            @autocomplete = "off",@Value = Model.ImportDate.ToString("dd-MM-yyyy")})
                        @Html.ValidationMessageFor(model => model.ImportDate, "", new { @class = "text-danger" })
                    </div>

                    <div class="col-md-6">
                        <span class="fw-bold">Supplier</span>
                        @Html.DropDownList("SupplierID", null, htmlAttributes: new { @class = "form-control" })
                        @Html.ValidationMessageFor(model => model.SupplierID, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="card-footer text-end">
                    <input type="submit" value="Save" class="btn btn-primary me-2" />
                    @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-secondary" })
                </div>
            }

            @section Scripts {
                @Scripts.Render("~/bundles/jqueryval")
            }
        </div>
    </div>
</div>
@model MedicinesProject.Medicines

@{
    ViewBag.Title = "Delete";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container delete-container">
    <div class="card border-danger">
        <div class="card-body">
            <h3 class="text-danger mb-4">Confirm delete this medicine?</h3>
            <hr />

            <dl class="row">
                <dt>
                    Trade Name
                </dt>

                <dd>
                    @Html.DisplayFor(model => model.TradeName)
                </dd>

                <dt>
                    Active Ingredient
                </dt>

                <dd>
                    @Html.DisplayFor(model => model.ActiveIngredient)
                </dd>

                <dt>
                    Category
                </dt>

                <dd>
                    @Html.DisplayFor(model => model.MedicineCategories.CategoryName)
                </dd>

                <dt>
                    Unit
                </dt>

                <dd>
                    @Html.DisplayFor(model => model.Unit)
                </dd>

                <dt>
                    Concentration
                </dt>

                <dd>
                    @Html.DisplayFor(model => model.Concentration)
                </dd>

                <dt>
                    Form
                </dt>

                <dd>
                    @Html.DisplayFor(model => model.Form)
                </dd>

                <dt>
                    Sale Price
                </dt>

                <dd>
                    @Html.DisplayFor(model => model.SalePrice)
                </dd>

                <dt>
                    Manufacturer
                </dt>

                <dd>
                    @Html.DisplayFor(model => model.Manufacturers.Name)
                </dd>

            </dl>

            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                <div class="card-footer text-end">
                    <input type="submit" value="Delete" class="btn btn-danger btn-space" />
                    @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-secondary" })
                </div>
            }
        </div>
    </div>
</div>

<!-- Bootstrap 5 JS (Optional) -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
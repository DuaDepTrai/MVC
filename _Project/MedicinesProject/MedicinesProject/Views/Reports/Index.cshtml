@model IEnumerable<MedicinesProject.Models.ViewModels.InventoryReportViewModel>

@{
    ViewBag.Title = "Reports";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Sticky Header -->
<div class="sticky-header mb-3 p-3 bg-light border rounded">
    <div class="d-flex justify-content-between align-items-center flex-wrap">
        <div class="button-group">
            <button id="btnInventory" class="btn btn-primary me-2" onclick="loadReport('Inventory')">
                Inventory
            </button>
            <button id="btnExpired" class="btn btn-danger me-2" onclick="loadReport('Expired')">
                Expired
            </button>
            <button id="btnNearExpiry" class="btn btn-warning" onclick="loadReport('NearExpiry')">
                Near Expiry
            </button>
        </div>

        @using (Html.BeginForm(null, null, FormMethod.Get, new { @class = "form-inline d-flex flex-wrap justify-content-end", id = "searchForm" }))
        {
            <div class="d-flex" style="width: 950px;">
                <div class="d-block" style="width: 850px; margin-right: 5px;">
                    <div style="width: 850px;">
                        <input type="text" name="searchStr" id="searchStr" class="form-control mr-2 mb-2" style="min-width: 850px;"
                               placeholder="Search by Receipt/Batch/Name/Active Ingredient" value="@ViewBag.CurrentSearch" />
                    </div>
                    <div style="vertical-align: central; width:850px">
                        @Html.DropDownList("activeIngredientFilter", ViewBag.ActiveIngredients as SelectList,
                            "Filter Active Ingredients", new { @id = "activeIngredientFilter", @class = "form-control select2" })
                        @Html.DropDownList("manufacturerFilter", ViewBag.Manufacturers as SelectList,
                            "Filter Manufacturers", new { @id = "manufacturerFilter", @class = "form-control select2" })
                        @Html.DropDownList("supplierFilter", ViewBag.Suppliers as SelectList,
                            "Filter Suppliers", new { @id = "supplierFilter", @class = "form-control select2" })
                    </div>
                </div>
                <div class="d-block">
                    <button type="submit" class="btn btn-primary mb-1">
                        <i class="fas fa-search"></i>
                    </button>
                    <a href="@Url.Action("Index", "Reports")" class="btn btn-primary mb-1 ml-0">
                        <i class="fas fa-sync-alt"></i>
                    </a>
                    <a href="#" id="downloadExcel" class="btn btn-success mb-1">
                        <i class="fas fa-download"></i>
                    </a>
                </div>
            </div>
        }
    </div>
</div>

<!-- Input chọn số tháng -->
<div id="monthSelect" style="display:none;" class="mb-3">
    <label for="inputMonth">Expiry Duration (Months):</label>
    <input type="number" id="inputMonth" name="months" class="form-control" style="width: 100px; display: inline-block;"
           min="1" value="@(ViewBag.Months ?? 3)" placeholder="Enter number of months" />
    <span id="inputMonthError" class="text-danger" style="display: none;">Please enter a number greater than 0</span>
</div>

<div class="toast-container position-fixed bottom-0 end-0 p-3">
    <div id="inputMonthToast" class="toast" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="toast-header">
            <strong class="me-auto">Invalid Input</strong>
            <button type="button" class="btn-close" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
        <div class="toast-body">
            Please enter a number greater than 0.
        </div>
    </div>
</div>

<!-- Content partial view -->
<div id="reportContent" data-total-pages="@ViewBag.TotalPages">
    @if (!string.IsNullOrEmpty(ViewBag.PartialViewName))
    {
        @Html.Partial((string)ViewBag.PartialViewName, Model)
    }
    else
    {
        @Html.Partial("_Inventory", Model)
    }
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/jqueryval")
    <!-- Thêm Select2 CSS và JS -->
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <!-- Bootstrap 5 JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Lưu reportType hiện tại
        var currentReportType = "@(ViewBag.PartialViewName?.Replace("_", "") ?? "Inventory")";

        // Khởi tạo Select2 cho dropdown
        $(document).ready(function () {
            $('#activeIngredientFilter').select2({
                placeholder: "Filter Active Ingredients",
                allowClear: true,
                width: '32.9%',
                dropdownAutoWidth: true
            });

            $('#manufacturerFilter').select2({
                placeholder: "Filter Manufacturers",
                allowClear: true,
                width: '32.9%',
                dropdownAutoWidth: true
            });

            $('#supplierFilter').select2({
                placeholder: "Filter Suppliers",
                allowClear: true,
                width: '32.9%',
                dropdownAutoWidth: true
            });

            // Tự động tải báo cáo khi chọn hoặc xóa dropdown
            $('#activeIngredientFilter, #manufacturerFilter, #supplierFilter').on('select2:select select2:clear', function (e) {
                $("#searchForm").submit();
            });

            // Gọi toggleFilters để áp dụng trạng thái ban đầu
            toggleFilters(currentReportType);
        });

        // Hàm tải báo cáo và thay đổi URL
        function loadReport(type, params = {}) {
            currentReportType = type;
            var url = "/Reports/" + type;
            var query = new URLSearchParams(params).toString();
            if (query) {
                url += "?" + query;
            }
            $("#btnInventory, #btnExpired, #btnNearExpiry").removeClass("active");
            $("#btn" + type).addClass("active");
            $("#reportContent").load(url, function (response, status, xhr) {
                if (status === "error") {
                    var msg = "Error loading report: " + xhr.status + " " + xhr.statusText;
                    $("#reportContent").html("<p>" + msg + "</p>");
                    console.error("Load report failed:", msg);
                } else {
                    history.pushState({ report: type, ...params }, "", url);
                    toggleFilters(type);
                    updateDownloadLink(type, params);
                    console.log("Pagination HTML:", $("#pagination-" + type.toLowerCase()).html());
                }
            });
        }

        // Xử lý click pagination
        $(document).on("click", "[id^='pagination-'] a[data-page]", function (e) {
            e.preventDefault();
            var page = $(this).data("page");
            var paginationId = $(this).closest("[id^='pagination-']").attr("id");
            var reportType = paginationId.replace("pagination-", "").toLowerCase();
            reportType = reportType === "nearexpiry" ? "NearExpiry" : reportType.charAt(0).toUpperCase() + reportType.slice(1);
            var params = {};
            var urlParams = new URLSearchParams(window.location.search);
            if (urlParams.has("searchStr")) params.searchStr = urlParams.get("searchStr");
            if (urlParams.has("activeIngredientFilter")) params.activeIngredientFilter = urlParams.get("activeIngredientFilter");
            if (urlParams.has("manufacturerFilter")) params.manufacturerFilter = urlParams.get("manufacturerFilter");
            if (urlParams.has("supplierFilter")) params.supplierFilter = urlParams.get("supplierFilter");
            if (urlParams.has("months")) params.months = urlParams.get("months");

            var currentPage = parseInt(urlParams.get("page")) || 1;
            var totalPages = parseInt($("#reportContent").data("total-pages") || 1);

            if (page === "previous") {
                params.page = currentPage > 1 ? currentPage - 1 : 1;
            } else if (page === "next") {
                params.page = currentPage < totalPages ? currentPage + 1 : totalPages;
            } else {
                params.page = parseInt(page);
            }

            console.log("Navigating to page:", params.page, "for", reportType);
            loadReport(reportType, params);
        });

        // Ẩn/hiện dropdown và input tháng
        function toggleFilters(type) {
            if (type === "Expired" || type === "NearExpiry") {
                $("#manufacturerFilter").next('.select2').hide();
                $("#supplierFilter").next('.select2').hide();
                if (type === "NearExpiry") {
                    $("#monthSelect").show();
                } else {
                    $("#monthSelect").hide();
                }
            } else {
                $("#manufacturerFilter").next('.select2').show();
                $("#supplierFilter").next('.select2').show();
                $("#monthSelect").hide();
            }
        }

        // Cập nhật href cho nút Download
        function updateDownloadLink(type, params) {
            var url = "/Reports/ExportToExcel?reportType=" + type;
            for (var key in params) {
                if (key !== "page") {
                    url += "&" + key + "=" + encodeURIComponent(params[key]);
                }
            }
            $("#downloadExcel").attr("href", url);
        }

        // Xử lý form tìm kiếm và lọc
        $("#searchForm").on("submit", function (e) {
            e.preventDefault();
            var searchStr = $("#searchStr").val();
            var activeIngredientFilter = $("#activeIngredientFilter").val();
            var manufacturerFilter = $("#manufacturerFilter").val();
            var supplierFilter = $("#supplierFilter").val();
            var months = $("#inputMonth").val();
            var currentType = getCurrentReportType();
            var params = { page: 1 };
            if (searchStr) params.searchStr = searchStr;
            if (activeIngredientFilter) params.activeIngredientFilter = activeIngredientFilter;
            if (manufacturerFilter && currentType === "Inventory") params.manufacturerFilter = manufacturerFilter;
            if (supplierFilter && currentType === "Inventory") params.supplierFilter = supplierFilter;
            if (currentType === "NearExpiry" && months) params.months = months;
            loadReport(currentType, params);
        });

        // Validate và xử lý inputMonth
        $("#inputMonth").on("change", function () {
            var value = $(this).val();
            if (value === "" || isNaN(value) || value <= 0) {
                var toast = new bootstrap.Toast(document.getElementById("inputMonthToast"));
                toast.show();
                $(this).val(3);
                return;
            }
            $("#searchForm").submit();
        });

        $("#inputMonth").on("keypress", function (e) {
            if (e.which === 13) {
                e.preventDefault();
                var value = $(this).val();
                if (value === "" || isNaN(value) || value <= 0) {
                    var toast = new bootstrap.Toast(document.getElementById("inputMonthToast"));
                    toast.show();
                    $(this).val(3);
                    return;
                }
                $("#searchForm").submit();
            }
        });

        // Lấy type báo cáo hiện tại
        function getCurrentReportType() {
            return currentReportType;
        }

        // Kiểm tra URL khi tải trang
        $(document).ready(function () {
            var path = window.location.pathname.toLowerCase();
            var params = {};
            var urlParams = new URLSearchParams(window.location.search);
            if (urlParams.has("searchStr")) params.searchStr = urlParams.get("searchStr");
            if (urlParams.has("activeIngredientFilter")) params.activeIngredientFilter = urlParams.get("activeIngredientFilter");
            if (urlParams.has("manufacturerFilter")) params.manufacturerFilter = urlParams.get("manufacturerFilter");
            if (urlParams.has("supplierFilter")) params.supplierFilter = urlParams.get("supplierFilter");
            if (urlParams.has("months")) {
                params.months = urlParams.get("months");
                $("#inputMonth").val(params.months);
            }
            if (urlParams.has("page")) params.page = urlParams.get("page");

            // Không gọi loadReport nếu đã render đúng partial view
            if (path === "/reports/inventory" && currentReportType !== "Inventory") {
                loadReport("Inventory", params);
            } else if (path === "/reports/expired" && currentReportType !== "Expired") {
                loadReport("Expired", params);
            } else if (path === "/reports/nearexpiry" && currentReportType !== "NearExpiry") {
                loadReport("NearExpiry", params);
            } else {
                toggleFilters(currentReportType); // Áp dụng toggleFilters cho trạng thái ban đầu
            }
        });

        // Xử lý sự kiện popstate
        window.onpopstate = function (event) {
            var path = window.location.pathname.toLowerCase();
            var params = {};
            var urlParams = new URLSearchParams(window.location.search);
            if (urlParams.has("searchStr")) params.searchStr = urlParams.get("searchStr");
            if (urlParams.has("activeIngredientFilter")) params.activeIngredientFilter = urlParams.get("activeIngredientFilter");
            if (urlParams.has("manufacturerFilter")) params.manufacturerFilter = urlParams.get("manufacturerFilter");
            if (urlParams.has("supplierFilter")) params.supplierFilter = urlParams.get("supplierFilter");
            if (urlParams.has("months")) {
                params.months = urlParams.get("months");
                $("#inputMonth").val(params.months);
            }
            if (urlParams.has("page")) params.page = urlParams.get("page");
            if (path === "/reports/inventory") {
                loadReport("Inventory", params);
            } else if (path === "/reports/expired") {
                loadReport("Expired", params);
            } else if (path === "/reports/nearexpiry") {
                loadReport("NearExpiry", params);
            } else {
                loadReport("Inventory", params);
            }
        };
    </script>
}
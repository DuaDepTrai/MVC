@model IEnumerable<HRM8.EMPLOYEE>

@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Index</h2>

<p>
    @Html.ActionLink("Create New", "Create")
</p>

@using (Html.BeginForm("Index", "Employees", FormMethod.Get))
{
    <p>
        Search by Name:
        @Html.TextBox("searchStr",  ViewBag.CurrentSearch as string)
        <input type="submit" value="Search" class="btn btn-default" />
    </p>
}

<table class="table">
    <tr>
        <td>
            <table class="table">
                <tr>
                    <th>
                        Organizations
                    </th>
                </tr>

                @foreach (var item in ViewBag.Organizations as List<HRM8.ORGANIZATION>)
                {
                    <tr>
                        <td>
                            @Html.ActionLink(item.OrganizationName, "Index", new { orgID = item.OrganizationID })
                        </td>
                    </tr>
                }
            </table>
        </td>
        <td>

            <table class="table">
                <tr>
                    <th>
                        @Html.DisplayNameFor(model => model.FirstName)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.LastName)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Address)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Phone)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Mobile)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Email)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Photo)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.CurriculumVitae)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.CurriculumVitaeType)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.DateofBirth)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.IndentifyNumber)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.ORGANIZATION.OrganizationName)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.POSITION.PositionName)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.SEX.SexName)
                    </th>
                    <th></th>
                </tr>

                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            @Html.DisplayFor(modelItem => item.FirstName)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.LastName)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.Address)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.Phone)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.Mobile)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.Email)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.Photo)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.CurriculumVitae)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.CurriculumVitaeType)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.DateofBirth)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.IndentifyNumber)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.ORGANIZATION.OrganizationName)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.POSITION.PositionName)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.SEX.SexName)
                        </td>
                        <td>
                            @Html.ActionLink("Edit", "Edit", new { id = item.EmployeeID }) |
                            @Html.ActionLink("Details", "Details", new { id = item.EmployeeID }) |
                            @Html.ActionLink("Delete", "Delete", new { id = item.EmployeeID })
                        </td>
                    </tr>
                }

            </table>

        </td>
</table>
@model HRM8.USERS

@{
    ViewBag.Title = "Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@{
    bool isAdmin = ViewBag.IsAdmin ?? false;
}

<h2>Details</h2>

<div>
    <h4>USERS</h4>
    <hr />
    <dl class="dl-horizontal">
        <dt>
            @Html.DisplayNameFor(model => model.UserName)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.UserName)
        </dd>

        <dt>
            @Html.DisplayNameFor(model => model.Discription)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.Discription)
        </dd>

        <dt>
            @Html.DisplayNameFor(model => model.ma_moi)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.ma_moi)
        </dd>

        <dt>
            @Html.DisplayNameFor(model => model.EMPLOYEE.FirstName)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.EMPLOYEE.FirstName)
        </dd>

    </dl>
</div>
<p>
    @Html.ActionLink("Edit", "Edit", new { id = Model.UsersID }, new { @class = "admin-only", @data_action = "edit" }) |
    @Html.ActionLink("Back to List", "Index")
</p>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const isAdmin = @isAdmin.ToString().ToLower();

            if (!isAdmin) {
                document.querySelectorAll(".admin-only").forEach(link => {
                    link.addEventListener("click", function (e) {
                        e.preventDefault();
                        const action = this.dataset.action;
                        alert("Only Admin can " + action + " users.");
                    });
                });
            }
        });
    </script>
}
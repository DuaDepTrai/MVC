@model IEnumerable<HRM7.USERS>

@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Index</h2>

<p>
    @Html.ActionLink("Create New", "Create")
</p>
<table class="table">
    <tr>
        <th>
            @Html.DisplayNameFor(model => model.UserName)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Discription)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.ma_moi)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.EMPLOYEE.FirstName)
        </th>
        <th></th>
    </tr>

@foreach (var item in Model) {
    <tr>
        <td>
            @Html.DisplayFor(modelItem => item.UserName)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Discription)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.ma_moi)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.EMPLOYEE.FirstName) @Html.DisplayFor(modelItem => item.EMPLOYEE.LastName)
        </td>
        <td>
            @Html.ActionLink("Edit", "Edit", new { id=item.UsersID }) |
            @Html.ActionLink("Details", "Details", new { id=item.UsersID }) |
            @Html.ActionLink("Delete", "Delete", new { id=item.UsersID })
        </td>
    </tr>
}

</table>

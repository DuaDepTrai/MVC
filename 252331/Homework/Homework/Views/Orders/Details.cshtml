@model Homework.Models.Orders

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container edit-container">
    <div class="card">
        <div class="card-body">
            <h2 class="text-primary">Order Information</h2>
            <hr />

            <dl class="row">

                <dt class="col-sm-3">@Html.DisplayNameFor(model => model.CustomerName)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.CustomerName)</dd>

                <dt class="col-sm-3">@Html.DisplayNameFor(model => model.EmployeeName)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.EmployeeName)</dd>

                <dt class="col-sm-3">@Html.DisplayNameFor(model => model.OrderDate)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.OrderDate)</dd>

                <dt class="col-sm-3">@Html.DisplayNameFor(model => model.RequiredDate)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.RequiredDate)</dd>

                <dt class="col-sm-3">@Html.DisplayNameFor(model => model.ShippedDate)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.ShippedDate)</dd>

                <dt class="col-sm-3">@Html.DisplayNameFor(model => model.ShipperName)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.ShipperName)</dd>

                <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Freight)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.Freight)</dd>

                <dt class="col-sm-3">@Html.DisplayNameFor(model => model.ShipName)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.ShipName)</dd>

                <dt class="col-sm-3">@Html.DisplayNameFor(model => model.ShipAddress)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.ShipAddress)</dd>

                <dt class="col-sm-3">@Html.DisplayNameFor(model => model.ShipCity)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.ShipCity)</dd>

                <dt class="col-sm-3">@Html.DisplayNameFor(model => model.ShipRegion)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.ShipRegion)</dd>

                <dt class="col-sm-3">@Html.DisplayNameFor(model => model.ShipPostalCode)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.ShipPostalCode)</dd>

                <dt class="col-sm-3">@Html.DisplayNameFor(model => model.ShipCountry)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.ShipCountry)</dd>

                @Html.HiddenFor(model => model.OrderID)

            </dl>

            <div class="card-footer text-end">
                @Html.ActionLink("Edit", "Edit", new { id = Model.OrderID }, new { @class = "btn btn-primary me-2" })
                @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-secondary" })
            </div>

            @{
                List<Homework.Models.OrderDetails> orderDetails = new List<Homework.Models.OrderDetails>();
                int i = 0;
                if (Session["listOrders"] != null)
                {


                    orderDetails = (List<Homework.Models.OrderDetails>)Session["listOrders"];

                }

            }


            @*<div class="text-end">
                @Html.ActionLink("Add New Product", "Create", "OrderDetails", null, new { @class = "btn btn-primary" })
            </div>*@
            <table class="table" border="1">
                <tr>
                    <th>
                        #
                    </th>

                    <th>
                        Product
                    </th>
                    <th>
                        Unit Price
                    </th>
                    <th>
                        Quantity
                    </th>
                    <th>
                        Discount
                    </th>
                    <th></th>
                </tr>

                @foreach (var item in orderDetails)
                {
                    i = i + 1;
                    <tr>
                        <td>
                            @i
                        </td>

                        @Html.Hidden("ProductID", item.ProductID)

                        <td>
                            @Html.Label(item.ProductName.ToString())
                        </td>
                        <td>
                            @Html.Label(item.UnitPrice.ToString())
                        </td>
                        <td>
                            @Html.Label(item.Quantity.ToString())
                        </td>
                        <td>
                            @Html.Label(item.Discount.ToString())
                        </td>
                        <td>
                            @Html.ActionLink("Details", "Details", "OrderDetails", new { OrderID = Model.OrderID, ProductID = item.ProductID }, null) |
                            @Html.ActionLink("Edit", "Edit", "OrderDetails", new { OrderID = Model.OrderID, ProductID = item.ProductID, position = "Edit" }, null) |
                            @Html.ActionLink("Delete", "DeleteConfirmed", "OrderDetails", new { OrderID = Model.OrderID, ProductID = item.ProductID }, null)
                        </td>
                    </tr>
                }

            </table>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

@model Homework.Models.Orders

@{
    ViewBag.Title = "Create";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script>
    document.addEventListener("DOMContentLoaded", function () {
        flatpickr(".flatpickr", {
            enableTime: true,
            dateFormat: "d-m-Y", // định dạng chuẩn với datetime-local
            time_24hr: true
        });
    });
</script>

<div class="container edit-container">
    <div class="card">
        <div class="card-body">
            <h2 class="text-primary">Create New Product</h2>
            <hr />

            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()

                @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                <div class="row mb-3">
                    <div class="col-md-6">
                        @Html.LabelFor(model => model.CustomerID, htmlAttributes: new { @class = "control-label" })
                        @Html.DropDownListFor(model => model.CustomerID, new SelectList(ViewBag.Customers, "CustomerID", "CompanyName"), "Select Customer", new { @class = "form-select" })
                        @Html.ValidationMessageFor(model => model.CustomerID, "", new { @class = "text-danger" })
                    </div>

                    <div class="col-md-6">
                        @Html.LabelFor(model => model.EmployeeID, htmlAttributes: new { @class = "control-label" })
                        @Html.DropDownListFor(model => model.EmployeeID, new SelectList(ViewBag.Employees, "EmployeeID", "FullName"), "Select Employee", new { @class = "form-select" })
                        @Html.ValidationMessageFor(model => model.EmployeeID, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-4">
                        @Html.LabelFor(model => model.OrderDate, htmlAttributes: new { @class = "control-label" })
                        @Html.TextBoxFor(model => model.OrderDate,
                            new
                            {
                                @class = "form-control flatpickr",
                                @autocomplete = "off",
                                @Value = (Model.OrderDate == default(DateTime) ? DateTime.Today : Model.OrderDate).ToString("dd/MM/yyyy")
                            })
                        @Html.ValidationMessageFor(model => model.OrderDate, "", new { @class = "text-danger" })
                    </div>

                    <div class="col-md-4">
                        @Html.LabelFor(model => model.RequiredDate, htmlAttributes: new { @class = "control-label" })
                        @Html.TextBoxFor(model => model.RequiredDate,
                            new
                            {
                                @class = "form-control flatpickr",
                                @autocomplete = "off",
                                @Value = (Model.RequiredDate == default(DateTime) ? DateTime.Today : Model.RequiredDate).ToString("dd/MM/yyyy")
                            })
                        @Html.ValidationMessageFor(model => model.RequiredDate, "", new { @class = "text-danger" })
                    </div>

                    <div class="col-md-4">
                        @Html.LabelFor(model => model.ShippedDate, htmlAttributes: new { @class = "control-label" })
                        @Html.TextBoxFor(model => model.ShippedDate,
                            new
                            {
                                @class = "form-control flatpickr",
                                @autocomplete = "off",
                                @Value = (Model.ShippedDate == default(DateTime) ? DateTime.Today : Model.ShippedDate).ToString("dd/MM/yyyy")
                            })
                        @Html.ValidationMessageFor(model => model.ShippedDate, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        @Html.LabelFor(model => model.ShipVia, htmlAttributes: new { @class = "control-label" })
                        @Html.DropDownListFor(model => model.ShipVia, new SelectList(ViewBag.Shippers, "ShipperID", "CompanyName"), "Select Shipper", new { @class = "form-select" })
                        @Html.ValidationMessageFor(model => model.ShipVia, "", new { @class = "text-danger" })
                    </div>

                    <div class="col-md-6">
                        @Html.LabelFor(model => model.Freight, htmlAttributes: new { @class = "control-label" })
                        @Html.EditorFor(model => model.Freight, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(model => model.Freight, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-3">
                        @Html.LabelFor(model => model.ShipName, htmlAttributes: new { @class = "control-label" })
                        @Html.EditorFor(model => model.ShipName, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(model => model.ShipName, "", new { @class = "text-danger" })
                    </div>

                    <div class="col-md-9">
                        @Html.LabelFor(model => model.ShipAddress, htmlAttributes: new { @class = "control-label" })
                        @Html.EditorFor(model => model.ShipAddress, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(model => model.ShipAddress, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-3">
                        @Html.LabelFor(model => model.ShipCity, htmlAttributes: new { @class = "control-label" })
                        @Html.EditorFor(model => model.ShipCity, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(model => model.ShipCity, "", new { @class = "text-danger" })
                    </div>

                    <div class="col-md-3">
                        @Html.LabelFor(model => model.ShipRegion, htmlAttributes: new { @class = "control-label" })
                        @Html.EditorFor(model => model.ShipRegion, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(model => model.ShipRegion, "", new { @class = "text-danger" })
                    </div>

                    <div class="col-md-3">
                        @Html.LabelFor(model => model.ShipPostalCode, htmlAttributes: new { @class = "control-label" })
                        @Html.EditorFor(model => model.ShipPostalCode, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(model => model.ShipPostalCode, "", new { @class = "text-danger" })
                    </div>

                    <div class="col-md-3">
                        @Html.LabelFor(model => model.ShipCountry, htmlAttributes: new { @class = "control-label" })
                        @Html.EditorFor(model => model.ShipCountry, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(model => model.ShipCountry, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="card-footer text-end">
                    <input type="submit" value="Create" class="btn btn-primary"
                           @(ViewBag.Customers == null || ViewBag.Employees == null || ViewBag.Shippers == null ? "disabled" : "") />
                    @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-secondary ms-2" })
                </div>
            }


            <hr />

            @*Order Details*@
            @{
                List<Homework.Models.OrderDetails> orderDetails = new List<Homework.Models.OrderDetails>();
                int i = 0;
                if (Session["listOrders"] != null)
                {


                    orderDetails = (List<Homework.Models.OrderDetails>)Session["listOrders"];

                }

            }

            <div class="text-end">
                @Html.ActionLink("Add New Product", "Create", "OrderDetails", null, new { @class = "btn btn-primary" })
            </div>

            <table class="table" border="1">
                <tr>
                    <th>#</th>
                    <th>Product</th>
                    <th>UnitPrice</th>
                    <th>Quantity</th>
                    <th>Discount</th>
                    <th></th>
                </tr>

                @foreach (var item in orderDetails)
                {
                    i = i + 1;
                    <tr>
                        <td>@i</td>
                            @Html.Hidden("ProductID", item.ProductID)
                        <td>@Html.Label(item.ProductName.ToString())</td>
                        <td>@Html.Label(item.UnitPrice.ToString())</td>
                        <td>@Html.Label(item.Quantity.ToString())</td>
                        <td>@Html.Label(item.Discount.ToString())</td>
                        <td>
                            @Html.ActionLink("Details", "Details", "OrderDetails", new { OrderID = Model.OrderID, ProductID = item.ProductID }, null) |
                            @Html.ActionLink("Edit", "Edit", "OrderDetails", new { OrderID = Model.OrderID, ProductID = item.ProductID, position = "Create" }, null) |
                            @Html.ActionLink("Delete", "DeleteConfirmed", "OrderDetails", new { OrderID = Model.OrderID, ProductID = item.ProductID }, null)
                        </td>
                    </tr>
                }
            </table>

        </div>
    </div>
</div>


<!-- Scripts -->

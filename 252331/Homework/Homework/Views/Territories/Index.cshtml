@model IEnumerable<Homework.Models.Territories>


@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

    @{
        ViewBag.Title = "Territories";
    }
    <p>
        @Html.ActionLink("Create New", "Create", null, new { @class = "btn btn-primary" })
    </p>
    <table class="table table-striped">
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.TerritoryID)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TerritoryDescription)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.RegionID)
            </th>
            <th></th>
        </tr>

        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.TerritoryID)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.TerritoryDescription)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.RegionID)
                </td>
                <td>
                    @Html.ActionLink("Edit", "Edit", new { id = item.TerritoryID }, new { @class = "btn btn-warning btn-sm" })
                    @Html.ActionLink("Details", "Details", new { id = item.TerritoryID }, new { @class = "btn btn-info btn-sm" })
                    @Html.ActionLink("Delete", "Delete", new { id = item.TerritoryID }, new { @class = "btn btn-danger btn-sm" })
                </td>
            </tr>
        }

    </table>

@model Homework.Models.Territories

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container edit-container">
    <div class="card">
        <div class="card-body">
            <h3 class="text-danger mb-4">Confirm delete this territory?</h3>
            <hr />

            <div class="mb-4">

                <dl class="row">
                    <dt class="col-sm-3">
                        @Html.DisplayNameFor(model => model.TerritoryID)
                    </dt>
                    <dd class="col-sm-9">
                        @Html.DisplayFor(model => model.TerritoryID)
                    </dd>

                    <dt class="col-sm-3">
                        @Html.DisplayNameFor(model => model.TerritoryDescription)
                    </dt>
                    <dd class="col-sm-9">
                        @Html.DisplayFor(model => model.TerritoryDescription)
                    </dd>

                    <dt class="col-sm-3">
                        @Html.DisplayNameFor(model => model.Region)
                    </dt>
                    <dd class="col-sm-9">
                        @Html.DisplayFor(model => model.Region)
                    </dd>
                </dl>

                @using (Html.BeginForm())
                {
                    @Html.AntiForgeryToken()

                    <div class="card-footer text-end">
                        <input type="submit" value="Delete" class="btn btn-danger" />
                        @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-secondary ms-2" })
                    </div>
                }
            </div>
        </div>
        </div>
</div>

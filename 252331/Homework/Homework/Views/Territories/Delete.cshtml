@model Homework.Models.Territories

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}


    <h3 class="text-danger">Are you sure you want to delete this?</h3>

    <div class="mb-4">
        <h4 class="text-primary">Territories</h4>
        <hr />

        <dl class="row">
            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.TerritoryID)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.TerritoryID)
            </dd>

            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.TerritoryDescription)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.TerritoryDescription)
            </dd>

            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.RegionID)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.RegionID)
            </dd>
        </dl>

        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()

            <div class="mt-3">
                <input type="submit" value="Delete" class="btn btn-danger" />
                @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-secondary ms-2" })
            </div>
        }
    </div>


@model Homework.Models.Territories

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}


    <h3 class="text-primary mb-4">Create Territory</h3>

    <script src="~/Scripts/jquery-1.10.2.min.js"></script>
    <script src="~/Scripts/jquery.validate.min.js"></script>
    <script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()

        @Html.ValidationSummary(true, "", new { @class = "text-danger mb-3" })

        <div class="mb-3">
            @Html.LabelFor(model => model.TerritoryID, htmlAttributes: new { @class = "form-label" })
            @Html.EditorFor(model => model.TerritoryID, new { htmlAttributes = new { @class = "form-control" } })
            @Html.ValidationMessageFor(model => model.TerritoryID, "", new { @class = "text-danger" })
        </div>

        <div class="mb-3">
            @Html.LabelFor(model => model.TerritoryDescription, htmlAttributes: new { @class = "form-label" })
            @Html.EditorFor(model => model.TerritoryDescription, new { htmlAttributes = new { @class = "form-control" } })
            @Html.ValidationMessageFor(model => model.TerritoryDescription, "", new { @class = "text-danger" })
        </div>

        <div class="mb-3">
            @Html.LabelFor(model => model.RegionID, htmlAttributes: new { @class = "form-label" })
            @Html.EditorFor(model => model.RegionID, new { htmlAttributes = new { @class = "form-control" } })
            @Html.ValidationMessageFor(model => model.RegionID, "", new { @class = "text-danger" })
        </div>

        <button type="submit" class="btn btn-success">Create</button>
        @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-secondary ms-2" })
    }


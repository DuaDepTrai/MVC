@model Homework.Models.Customers

@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Delete Customer</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Bootstrap 5 CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

    <style>
        body {
            background-color: #f8f9fa;
            padding-top: 50px;
        }

        .delete-container {
            max-width: 700px;
            margin: auto;
        }

        .card {
            box-shadow: 0 0 12px rgba(0, 0, 0, 0.1);
        }

        .btn-space {
            margin-right: 10px;
        }
    </style>
</head>
<body>

    <div class="container delete-container">
        <div class="card border-danger">
            <div class="card-body">
                <h3 class="card-title text-danger text-center">Confirm Delete</h3>
                <hr />

                <dl class="row">
                    <dt class="col-sm-4">@Html.DisplayNameFor(model => model.CustomerID)</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.CustomerID)</dd>

                    <dt class="col-sm-4">@Html.DisplayNameFor(model => model.CompanyName)</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.CompanyName)</dd>

                    <dt class="col-sm-4">@Html.DisplayNameFor(model => model.ContactName)</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.ContactName)</dd>

                    <dt class="col-sm-4">@Html.DisplayNameFor(model => model.ContactTitle)</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.ContactTitle)</dd>

                    <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Address)</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.Address)</dd>

                    <dt class="col-sm-4">@Html.DisplayNameFor(model => model.City)</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.City)</dd>

                    <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Region)</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.Region)</dd>

                    <dt class="col-sm-4">@Html.DisplayNameFor(model => model.PostalCode)</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.PostalCode)</dd>

                    <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Country)</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.Country)</dd>

                    <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Phone)</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.Phone)</dd>

                    <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Fax)</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.Fax)</dd>
                </dl>

                @using (Html.BeginForm())
                {
                    @Html.AntiForgeryToken()

                    <div class="text-end mt-4">
                        <input type="submit" value="Delete" class="btn btn-danger btn-space" />
                        @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-secondary" })
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Bootstrap 5 JS (Optional) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>

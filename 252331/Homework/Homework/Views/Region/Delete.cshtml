@model Homework.Models.Region

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

    <h3 class="text-danger mb-3">Are you sure you want to delete this?</h3>

    <div class="card shadow-sm">
        <div class="card-body">
            <h4 class="text-primary">Region</h4>
            <hr />

            <dl class="row">
                <dt class="col-sm-3">
                    @Html.DisplayNameFor(model => model.RegionDescription)
                </dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.RegionDescription)
                </dd>
            </dl>

            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()

                <div class="mt-4">
                    <input type="submit" value="Delete" class="btn btn-danger" />
                    @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-secondary ms-2" })
                </div>
            }
        </div>
    </div>

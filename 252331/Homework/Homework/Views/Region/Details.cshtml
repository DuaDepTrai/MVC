@model Homework.Models.Region

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container edit-container">
    <div class="card">
        <div class="card-body">
            <h2 class="text-primary">Region Information</h2>
            <hr />

            <dl class="row">
                <dt class="col-sm-3">
                    @Html.DisplayNameFor(model => model.RegionDescription)
                </dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.RegionDescription)
                </dd>
            </dl>

            <div class="card-footer text-end">
                @Html.ActionLink("Edit", "Edit", new { id = Model.RegionID }, new { @class = "btn btn-warning me-2" })
                @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-secondary" })
            </div>
        </div>
    </div>
</div>
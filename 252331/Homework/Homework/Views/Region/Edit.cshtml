@model Homework.Models.Region

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

    <h3 class="mb-4 text-primary">Edit Region</h3>

    <script src="~/Scripts/jquery-1.10.2.min.js"></script>
    <script src="~/Scripts/jquery.validate.min.js"></script>
    <script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()

        @Html.ValidationSummary(true, "", new { @class = "text-danger mb-3" })
        @Html.HiddenFor(model => model.RegionID)

        <div class="mb-3">
            @Html.LabelFor(model => model.RegionDescription, htmlAttributes: new { @class = "form-label" })
            @Html.EditorFor(model => model.RegionDescription, new { htmlAttributes = new { @class = "form-control" } })
            @Html.ValidationMessageFor(model => model.RegionDescription, "", new { @class = "text-danger" })
        </div>

        <button type="submit" class="btn btn-success">Save</button>
        @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-secondary ms-2" })
    }
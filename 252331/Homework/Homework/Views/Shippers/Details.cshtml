@model Homework.Models.Shippers

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Shipper Details";
}

<div class="container mt-5">
    <div class="card">
        <div class="card-header">
            <h4 class="mb-0">Shipper Details</h4>
        </div>
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">@Html.DisplayNameFor(model => model.CompanyName)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.CompanyName)</dd>

                <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Phone)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.Phone)</dd>
            </dl>
        </div>
        <div class="card-footer">
            @Html.ActionLink("Edit", "Edit", new { id = Model.ShipperID }, new { @class = "btn btn-warning me-2" })
            @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-secondary" })
        </div>
    </div>
</div>

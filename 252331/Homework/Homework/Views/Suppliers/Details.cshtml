@model Homework.Models.Suppliers

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container edit-container">
    <div class="card">
        <div class="card-body">

            <h2 class="text-primary">Supplier Information</h2>
            <hr />

            <dl class="row">
                <dt class="col-sm-3">@Html.DisplayNameFor(model => model.ContactName)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.ContactName)</dd>

                <dt class="col-sm-3">@Html.DisplayNameFor(model => model.ContactTitle)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.ContactTitle)</dd>

                <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Address)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.Address)</dd>

                <dt class="col-sm-3">@Html.DisplayNameFor(model => model.City)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.City)</dd>

                <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Region)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.Region)</dd>

                <dt class="col-sm-3">@Html.DisplayNameFor(model => model.PostalCode)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.PostalCode)</dd>

                <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Country)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.Country)</dd>

                <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Phone)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.Phone)</dd>

                <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Fax)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.Fax)</dd>

                <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Homepage)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.Homepage)</dd>
            </dl>
        </div>
        <div class="card-footer text-end">
            @Html.ActionLink("Edit", "Edit", new { id = Model.SupplierID }, new { @class = "btn btn-warning me-2" })
            @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-secondary" })
        </div>
    </div>


</div>
    </div>
</div>
@model Homework.Models.Suppliers

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script src="~/Scripts/jquery-1.10.2.min.js"></script>
<script src="~/Scripts/jquery.validate.min.js"></script>
<script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>

<div class="container edit-container">
    <div class="card">
        <div class="card-body">


            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()
                <h2 class="text-primary">Edit Supplier</h2>
                <hr />
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                <div class="mb-3 row">
                    <div class="col-md-6">
                        @Html.LabelFor(m => m.CompanyName, htmlAttributes: new { @class = "form-label" })
                        @Html.EditorFor(m => m.CompanyName, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(m => m.CompanyName, "", new { @class = "text-danger" })
                    </div>
                    <div class="col-md-6">
                        @Html.LabelFor(m => m.ContactName, htmlAttributes: new { @class = "form-label" })
                        @Html.EditorFor(m => m.ContactName, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(m => m.ContactName, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="mb-3 row">
                    <div class="col-md-6">
                        @Html.LabelFor(m => m.ContactTitle, htmlAttributes: new { @class = "form-label" })
                        @Html.EditorFor(m => m.ContactTitle, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(m => m.ContactTitle, "", new { @class = "text-danger" })
                    </div>
                    <div class="col-md-6">
                        @Html.LabelFor(m => m.Address, htmlAttributes: new { @class = "form-label" })
                        @Html.EditorFor(m => m.Address, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(m => m.Address, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="mb-3 row">
                    <div class="col-md-6">
                        @Html.LabelFor(m => m.City, htmlAttributes: new { @class = "form-label" })
                        @Html.EditorFor(m => m.City, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(m => m.City, "", new { @class = "text-danger" })
                    </div>
                    <div class="col-md-6">
                        @Html.LabelFor(m => m.Region, htmlAttributes: new { @class = "form-label" })
                        @Html.EditorFor(m => m.Region, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(m => m.Region, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="mb-3 row">
                    <div class="col-md-6">
                        @Html.LabelFor(m => m.PostalCode, htmlAttributes: new { @class = "form-label" })
                        @Html.EditorFor(m => m.PostalCode, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(m => m.PostalCode, "", new { @class = "text-danger" })
                    </div>
                    <div class="col-md-6">
                        @Html.LabelFor(m => m.Country, htmlAttributes: new { @class = "form-label" })
                        @Html.EditorFor(m => m.Country, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(m => m.Country, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="mb-3 row">
                    <div class="col-md-6">
                        @Html.LabelFor(m => m.Phone, htmlAttributes: new { @class = "form-label" })
                        @Html.EditorFor(m => m.Phone, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(m => m.Phone, "", new { @class = "text-danger" })
                    </div>
                    <div class="col-md-6">
                        @Html.LabelFor(m => m.Fax, htmlAttributes: new { @class = "form-label" })
                        @Html.EditorFor(m => m.Fax, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(m => m.Fax, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="mb-3 row">
                    <div class="col-md-6">
                        @Html.LabelFor(m => m.Homepage, htmlAttributes: new { @class = "form-label" })
                        @Html.EditorFor(m => m.Homepage, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(m => m.Homepage, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="card-footer text-end">
                    <button type="submit" class="btn btn-primary">Save</button>
                    @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-secondary ms-2" })
                </div>
            }

        </div>
    </div>
</div>
<!-- Bootstrap 5 JS (Optional) -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

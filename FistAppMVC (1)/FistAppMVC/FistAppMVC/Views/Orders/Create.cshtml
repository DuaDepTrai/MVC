@{ 
    List<FistAppMVC.Models.OrderDetails> orderDetails = new List<FistAppMVC.Models.OrderDetails>();
    int i = 0;
    if (Session["listorders"]!=null)
    {


        orderDetails = (List<FistAppMVC.Models.OrderDetails>) Session["listorders"];

    }

}


<p>
    @Html.ActionLink("Create New", "Create", "OrderDetails")
</p>
<table class="table" border="1">
    <tr>
        <th>
            STT
        </th>
       
        <th>
            Tên sản phẩm
        </th>
        <th>
            Đơn giá
        </th>
        <th>
            Số lượng
        </th>
        <th>
            Khuyến mại
        </th>
        <th></th>
    </tr>

    @foreach (var item in orderDetails)
    {
        i = i + 1;
        <tr>
            <td>
                @i
            </td>
            
                @Html.Hidden("ProductID", item.ProductID)
            
            <td>
                @Html.Label(item.ProductName.ToString())
            </td>
            <td>
                @Html.Label(item.UnitPrice.ToString())
            </td>
            <td>
                @Html.Label(item.Quantity.ToString())
            </td>
            <td>
                @Html.Label(item.Discount.ToString())
            </td>
            <td>
                @Html.ActionLink("Edit", "Edit", new { OrderID = Model.OrderID, ProductID = item.ProductID }, null) |
                @Html.ActionLink("Details", "Details", new { OrderID = Model.OrderID, ProductID = item.ProductID }, null) |
                @Html.ActionLink("Delete", "Delete", new { OrderID = Model.OrderID, ProductID = item.ProductID }, null)
            </td>
        </tr>
    }

</table>




<div>
    @Html.ActionLink("Back to List", "Index")
</div>

